# ============================================================
# CONFIGURACIÓN — WhatsApp Weekly Summary
# Copia este archivo como .env y completa los valores reales.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- Claude API (Anthropic) ---
# Obtén tu clave en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Nombre exacto del grupo de WhatsApp ---
# Debe coincidir letra por letra (incluyendo espacios y guiones)
WHATSAPP_GROUP_NAME=Team AORA - LA GARANTÍA (Temas Operativos)

# --- Email de envío (SMTP) ---
# Configuración para Gmail. Si usas otro proveedor, ajusta host/port.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu-cuenta@gmail.com
# Para Gmail: usa una "Contraseña de aplicación" (App Password), no tu contraseña normal.
# Genera una en: https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx-xxxx-xxxx-xxxx

# --- Destinatarios del resumen semanal ---
# Separa múltiples emails con coma
EMAIL_FROM="AORA Operaciones <tu-cuenta@gmail.com>"
EMAIL_TO=gerencia@empresa.com,operaciones@empresa.com

# --- Horario del cron (zona horaria local del servidor) ---
# Por defecto: lunes a las 08:00
# Formato: minuto hora día-mes mes día-semana
CRON_SCHEDULE=0 8 * * 1

# --- Días hacia atrás que cubre el resumen ---
# 7 = última semana completa
DAYS_BACK=7

# --- Directorio para guardar sesión de WhatsApp y datos históricos ---
# Ruta relativa al script. No cambiar si no es necesario.
SESSION_DIR=./session
DATA_DIR=./data
